// Production schema, used when deploying with a Postgres DATABASE_URL.
// Generate against it with: npx prisma generate --schema=prisma/schema.postgres.prisma
// Create tables once with: npx prisma db push --schema=prisma/schema.postgres.prisma

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  amount    Float
  category  String
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}
