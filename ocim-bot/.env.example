# ============================================================
# OCIM Chemical Inventory Bot — Environment Variables
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# IMPORTANT: variable names below are the conventional names.
# Verify they match what telegram_bot_system.py actually reads:
#   grep -oE 'os\.(environ\[|getenv\()."?[A-Z_]+' telegram_bot_system.py | sort -u
# Rename any that differ.
# ============================================================

# --- Telegram (from @BotFather -> /newbot) ---
# Format: <numeric-id>:<35-char-token>, e.g. 1234567890:AAF...xyz
TELEGRAM_BOT_TOKEN=

# --- Claude API (https://console.anthropic.com/ -> API Keys) ---
# Starts with sk-ant-
ANTHROPIC_API_KEY=

# --- Gemini API (https://ai.google.dev/ -> Get API key) ---
# Starts with AIza
GEMINI_API_KEY=

# --- Google Apps Script backend ---
# The Web App URL from: Apps Script editor -> Deploy -> New deployment
#   -> Type: Web app -> Execute as: Me -> Who has access: Anyone
# Ends with /exec (NOT /dev — /dev only works for the logged-in owner)
APPS_SCRIPT_URL=

# --- Google Sheet ---
# From the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# --- Access control (optional but recommended) ---
# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Get your ID by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=

# --- Runtime (optional) ---
LOG_LEVEL=INFO
